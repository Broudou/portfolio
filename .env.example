# ==============================================================================
# Root environment reference
# ------------------------------------------------------------------------------
# This file documents every environment variable used across the monorepo.
# Copy it to `server/.env` and `client/.env` (see the split below) and fill in
# real values. Never commit the resulting .env files.
# ==============================================================================

# ---------- server/.env ----------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Secret used to sign/verify JWTs. Must be identical to CLIENT's JWT_SECRET
# because client/src/hooks.server.ts verifies the cookie locally.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Name of the httpOnly cookie carrying the JWT (must match client)
COOKIE_NAME=portfolio_token

# Comma-separated list of origins allowed to call the API directly
# (defense-in-depth only — the browser never calls Express directly in this app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local media storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# Outbound contact-form notifications (optional — service no-ops if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

LOG_LEVEL=info

# ---------- client/.env ----------
# Base URL SvelteKit's server-side code uses to reach the Express API
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Must match server's JWT_SECRET / COOKIE_NAME above
JWT_SECRET=replace-with-a-long-random-string
COOKIE_NAME=portfolio_token

# Public site origin, used for absolute URLs in SEO tags, sitemap, JSON-LD
PUBLIC_SITE_URL=http://localhost:5173
