{
  "extends": ["../tsconfig.base.json", "./.svelte-kit/tsconfig.json"],
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  }
}
