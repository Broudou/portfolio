NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Must match client's JWT_SECRET (client/.env) — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Must match client's COOKIE_NAME
COOKIE_NAME=portfolio_token

# Comma-separated list of origins allowed to call the API directly (defense-in-depth)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# Optional — contact form emails only send if these are set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

LOG_LEVEL=info
